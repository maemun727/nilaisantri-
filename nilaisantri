        // --- RENDER TABLE & CALCULATE SUMS ---
        function renderTable() {
            const tbody = document.getElementById("grades-tbody");
            const searchQuery = document.getElementById("search-input").value.toLowerCase();
            const semKey = currentSemester === 1 ? "sem1" : "sem2";

            // Always ensure alphabetical sort
            appData[currentClass].sort((a, b) => a.name.localeCompare(b.name, 'id', { sensitivity: 'base' }));

            const students = appData[currentClass];
            const filtered = students.filter(s => s.name.toLowerCase().includes(searchQuery));

            let totalClassScore = 0;
            let highestTotal = -1;
            let topStudentName = "-";

            // Calculate class-wide stats for current semester
            students.forEach(s => {
                const sum = s[semKey].reduce((acc, val) => acc + (Number(val) || 0), 0);
                totalClassScore += sum;
                if (sum > highestTotal && sum > 0) {
                    highestTotal = sum;
                    topStudentName = s.name;
                }
            });

            document.getElementById("stat-students").textContent = students.length;
            const classAvg = students.length > 0 ? (totalClassScore / (students.length * 4)).toFixed(1) : "0.0";
            document.getElementById("stat-avg").textContent = classAvg;
            document.getElementById("stat-max").textContent = highestTotal > 0 ? highestTotal : "0";
            document.getElementById("stat-top-student").textContent = topStudentName;

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="py-8 text-center text-slate-400 text-sm">
                            Tidak ada data santri yang cocok dengan pencarian.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map((student, index) => {
                const scores = student[semKey];
                const total = scores.reduce((acc, val) => acc + (Number(val) || 0), 0);
                const avg = (total / 4).toFixed(1);

                return `
                    <tr class="hover:bg-sky-50/70 dark:hover:bg-slate-800/50 transition-colors group">
                        <td class="py-3 px-4 text-center font-medium text-slate-400 text-xs">${index + 1}</td>
                        <td class="py-3 px-4 font-medium text-slate-800 dark:text-slate-100">
                            <button onclick="openEditStudentModal('${student.id}')" class="text-left hover:text-emerald-700 dark:hover:text-amber-400 transition-colors flex items-center gap-1.5">
                                <span>${student.name}</span>
                                <i data-lucide="pencil" class="w-3 h-3 opacity-0 group-hover:opacity-60"></i>
                            </button>
                        </td>
                        ${[0, 1, 2, 3].map(examIdx => `
                            <td class="py-2.5 px-2 text-center">
                                <input type="number" min="0" max="100" step="0.5"
                                    value="${scores[examIdx] === 0 ? '' : scores[examIdx]}"
                                    placeholder="0"
                                    onchange="updateScore('${student.id}', ${examIdx}, this.value)"
                                    class="w-20 text-center py-1.5 px-2 rounded-lg bg-sky-50/60 dark:bg-slate-800 border border-sky-200/70 dark:border-slate-700 text-slate-800 dark:text-white font-medium focus:outline-none focus:border-emerald-700 dark:focus:border-amber-400 focus:bg-white dark:focus:bg-slate-900 transition-all">
                            </td>
                        `).join("")}
                        <td class="py-3 px-4 text-center font-display font-bold text-emerald-900 dark:text-amber-400 bg-amber-50/40 dark:bg-amber-500/5 text-base">
                            ${total}
                        </td>
                        <td class="py-3 px-4 text-center font-semibold text-xs">
                            <span class="px-2.5 py-1 rounded-full ${
                                avg >= 75 ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' :
                                avg >= 50 ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' :
                                'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400'
                            }">
                                ${avg}
                            </span>
                        </td>
                        <td class="py-3 px-3 text-center">
                            <button onclick="deleteStudent('${student.id}')" title="Hapus Santri"
                                class="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/50 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join("");

            lucide.createIcons();
        }

        // --- UPDATE SCORE ---
        function updateScore(studentId, examIdx, value) {
            const numVal = value === "" ? 0 : Math.max(0, Math.min(100, parseFloat(value) || 0));
            const semKey = currentSemester === 1 ? "sem1" : "sem2";
            const student = appData[currentClass].find(s => s.id === studentId);
            if (student) {
                student[semKey][examIdx] = numVal;
                saveData();
                renderTable();
            }
        }

        // --- FLEXIBLE STUDENT CRUD (ADD, EDIT, DELETE) ---
        function openAddStudentModal() {
            editingStudentId = null;
            document.getElementById("modal-title").textContent = `Tambah Santri (${currentClass})`;
            document.getElementById("student-name-input").value = "";
            document.getElementById("student-modal").classList.remove("hidden");
            document.getElementById("student-name-input").focus();
        }

        function openEditStudentModal(studentId) {
            const student = appData[currentClass].find(s => s.id === studentId);
            if (!student) return;
            editingStudentId = studentId;
            document.getElementById("modal-title").textContent = "Ubah Nama Santri";
            document.getElementById("student-name-input").value = student.name;
            document.getElementById("student-modal").classList.remove("hidden");
            document.getElementById("student-name-input").focus();
        }

        function closeStudentModal() {
            document.getElementById("student-modal").classList.add("hidden");
        }

        function saveStudent() {
            const nameInput = document.getElementById("student-name-input").value.trim();
            if (!nameInput) return;

            if (editingStudentId) {
                const student = appData[currentClass].find(s => s.id === editingStudentId);
                if (student) student.name = nameInput;
                showToast("Nama santri berhasil diperbarui & diurutkan abjad!");
            } else {
                appData[currentClass].push({
                    id: `${currentClass.replace(/\s+/g, '')}_${Date.now()}`,
                    name: nameInput,
                    sem1: [0, 0, 0, 0],
                    sem2: [0, 0, 0, 0]
                });
                showToast("Santri baru berhasil ditambahkan & diurutkan abjad!");
            }

            saveData();
            closeStudentModal();
            renderClassTabs();
            renderTable();
        }

        function deleteStudent(studentId) {
            appData[currentClass] = appData[currentClass].filter(s => s.id !== studentId);
            saveData();
            renderClassTabs();
            renderTable();
            showToast("Data santri dihapus dari kelas.");
        }

        // --- AI ANALYSIS FEATURE (Gemini API with Smart Local Fallback) ---
        async function triggerAIAnalysis() {
            const panel = document.getElementById("ai-panel");
            const content = document.getElementById("ai-content");
            panel.classList.remove("hidden");
            content.innerHTML = `<div class="flex items-center gap-2 text-amber-300"><i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>AI sedang menganalisis performa ujian bulanan ${currentClass} (Semester ${currentSemester})...</span></div>`;
            lucide.createIcons();

            const semKey = currentSemester === 1 ? "sem1" : "sem2";
            const students = appData[currentClass].map(s => {
                const total = s[semKey].reduce((a, b) => a + (Number(b) || 0), 0);
                return { name: s.name, scores: s[semKey], total, avg: (total / 4).toFixed(1) };
            });

            const scoredStudents = students.filter(s => s.total > 0);

            if (scoredStudents.length === 0) {
                content.innerHTML = `<p>Belum ada nilai ujian yang diinput pada <strong>${currentClass} - Semester ${currentSemester}</strong>. Silakan isi beberapa nilai ujian terlebih dahulu agar AI dapat memberikan evaluasi dan rekomendasi pembelajaran santri.</p>`;
                return;
            }

            // Sort by total score for summary
            const ranked = [...scoredStudents].sort((a, b) => b.total - a.total);
            const top3 = ranked.slice(0, 3).map(s => `${s.name} (Total: ${s.total}, Rata-rata: ${s.avg})`).join(", ");
            const needAttention = ranked.filter(s => Number(s.avg) < 65).map(s => s.name).slice(0, 5).join(", ");

            const prompt = `Bertindaklah sebagai asisten akademik cerdas untuk Ustadz Maemun Muzaki di Pon pes Nurul Huda. Analisis singkat data ujian bulanan (4 kali ujian) untuk ${currentClass} Semester ${currentSemester}:
- Jumlah santri dinilai: ${scoredStudents.length} dari ${students.length} santri.
- Peringkat 3 teratas: ${top3}.
- Santri yang perlu pendampingan ekstra (rata-rata < 65): ${needAttention || "Tidak ada, semua baik"}.
Berikan ringkasan evaluasi yang islami, memotivasi, profesional, dan 3 saran taktis singkat untuk peningkatan mutu belajar santri dalam bahasa Indonesia (maksimal 120 kata).`;

            try {
                const apiKey = ""; // Runtime key if available
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                const response = await fetch(apiUrl, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }]
                    })
                });

                if (!response.ok) throw new Error("API Fallback");
                const result = await response.json();
                const aiText = result.candidates?.[0]?.content?.parts?.[0]?.text;
                if (!aiText) throw new Error("Empty AI response");

                content.innerHTML = `<div class="prose prose-invert max-w-none text-sm leading-relaxed">${aiText.replace(/\n/g, '<br>')}</div>`;
            } catch (err) {
                // Smart Offline/GitHub-Pages Fallback Analysis so it ALWAYS works on GitHub!
                content.innerHTML = `
                    <p><strong>Ringkasan Evaluasi ${currentClass} (Semester ${currentSemester}):</strong></p>
                    <ul class="list-disc pl-5 space-y-1 text-emerald-100/90">
                        <li><strong>Santri Berprestasi Tertinggi:</strong> ${top3}.</li>
                        <li><strong>Fokus Pendampingan:</strong> ${needAttention ? `Perlu muraja'ah tambahan untuk ananda <em>${needAttention}</em>.` : 'Alhamdulillah, seluruh santri yang dinilai telah melampaui standar kelulusan dasar.'}</li>
                        <li><strong>Rekomendasi Ustadz Maemun Muzaki:</strong> Adakan kelompok belajar sebaya (tutor santri senior) menjelang Ujian Bulanan berikutnya untuk menjaga konsistensi hafalan dan pemahaman kitab.</li>
                    </ul>
                `;
            }
        }

        // --- EXPORT TO CSV (EXCEL COMPATIBLE) ---
        function exportToCSV() {
            const semKey = currentSemester === 1 ? "sem1" : "sem2";
            const students = appData[currentClass];
            let csv = `No,Nama Santri,Ujian 1,Ujian 2,Ujian 3,Ujian 4,Total Nilai,Rata-Rata\n`;

            students.forEach((s, i) => {
                const sc = s[semKey];
                const tot = sc.reduce((a, b) => a + (Number(b) || 0), 0);
                const avg = (tot / 4).toFixed(1);
                csv += `${i + 1},"${s.name}",${sc[0]},${sc[1]},${sc[2]},${sc[3]},${tot},${avg}\n`;
            });

            const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `Nilai_${currentClass.replace(/\s+/g, '_')}_Semester_${currentSemester}_Nurul_Huda.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("File Excel (CSV) berhasil diunduh!");
        }

        // --- TOAST HELPER ---
        function showToast(msg) {
            const toast = document.getElementById("toast");
            document.getElementById("toast-msg").textContent = msg;
            toast.classList.remove("translate-y-20", "opacity-0");
            setTimeout(() => {
                toast.classList.add("translate-y-20", "opacity-0");
            }, 3000);
        }
