                        <i data-lucide="graduation-cap" class="w-6 h-6 stroke-[2.2]"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-display font-bold text-amber-400 text-sm sm:text-base tracking-wide">Maemun Muzaki</span>
                            <span class="hidden sm:inline-block text-amber-500/50">|</span>
                            <span class="hidden sm:inline-block text-xs sm:text-sm font-medium text-emerald-100">Pon pes Nurul Huda</span>
                        </div>
                        <p class="text-[11px] text-emerald-300/80 sm:hidden">Pon pes Nurul Huda</p>
                    </div>
                </div>

                <!-- Right Controls: Theme Toggle & Logout -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <!-- AI Status Badge -->
                    <div class="hidden md:flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/70 border border-amber-500/30 text-xs text-amber-300">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>AI Evaluator Ready</span>
                    </div>

                    <!-- Dark / Light Mode Toggle -->
                    <button id="theme-toggle" title="Ganti Tema Gelap/Terang"
                        class="p-2.5 rounded-xl bg-emerald-800/80 hover:bg-emerald-700 border border-amber-500/30 text-amber-300 transition-colors">
                        <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                        <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                    </button>

                    <!-- Logout Button -->
                    <button id="logout-btn" title="Keluar"
                        class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-red-950/60 hover:bg-red-900/80 border border-red-500/30 text-red-200 text-xs font-medium transition-colors">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Keluar</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

