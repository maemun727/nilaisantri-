    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-emerald-950 text-amber-300 border border-amber-500/50 px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 text-xs font-medium">
        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
        <span id="toast-msg">Perubahan tersimpan</span>
