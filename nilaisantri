                    <button onclick="openAddStudentModal()" 
                        class="flex-1 min-w-[130px] py-2.5 px-3 rounded-xl bg-emerald-900 hover:bg-emerald-800 text-amber-300 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all shadow-sm">
