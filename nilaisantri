        function initData() {
            const saved = localStorage.getItem("nurul_huda_grades_v1");
            if (saved) {
                appData = JSON.parse(saved);
            } else {
                buildDefaultData();
            }
        }

        function buildDefaultData() {
            appData = {};
            for (const [className, names] of Object.entries(initialClassesData)) {
                // Sort alphabetically (case-insensitive)
                const sortedNames = [...names].sort((a, b) => a.localeCompare(b, 'id', { sensitivity: 'base' }));
                appData[className] = sortedNames.map((name, idx) => ({
                    id: `${className.replace(/\s+/g, '')}_${idx}_${Date.now()}`,
                    name: name,
                    sem1: [0, 0, 0, 0],
                    sem2: [0, 0, 0, 0]
                }));
            }
            saveData();
        }

        function saveData() {
            localStorage.setItem("nurul_huda_grades_v1", JSON.stringify(appData));
        }

        function resetDefaultData() {
            // Custom inline confirmation toast/prompt replacement
            buildDefaultData();
            renderTable();
            showToast("Data santri berhasil dikembalikan ke pengaturan awal!");
