                        <span>Analisis Nilai AI</span>
                    </button>

                    <button onclick="exportToCSV()" title="Unduh Data CSV"
                        class="py-2.5 px-3 rounded-xl bg-sky-50 hover:bg-sky-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-sky-200 dark:border-slate-700 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Export</span>
                    </button>
                </div>
            </div>

            <!-- AI Insight Box (Hidden by default, shown when AI Analysis is triggered) -->
            <div id="ai-panel" class="hidden bg-gradient-to-r from-emerald-950 to-emerald-900 text-white rounded-2xl p-5 border-2 border-amber-500/60 shadow-lg relative">
                <button onclick="document.getElementById('ai-panel').classList.add('hidden')" class="absolute top-4 right-4 text-emerald-300 hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
                <div class="flex items-start gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-amber-400/20 border border-amber-400/50 flex items-center justify-center text-amber-300 shrink-0 mt-0.5">
