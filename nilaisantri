                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 2. MAIN APPLICATION (Ice-Blue/White Premium Theme + Dark Mode Toggle) -->
    <!-- ===================================================================== -->
    <div id="app-screen" class="hidden min-h-screen flex flex-col">
        
