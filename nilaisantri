        // --- RENDER CLASS TABS ---
        function renderClassTabs() {
            const container = document.getElementById("class-tabs");
            const classNames = Object.keys(appData);
            container.innerHTML = classNames.map(cls => {
                const isActive = cls === currentClass;
                const count = appData[cls].length;
                return `
                    <button onclick="selectClass('${cls}')"
                        class="flex items-center justify-between px-3.5 py-2.5 rounded-xl border text-left transition-all ${
