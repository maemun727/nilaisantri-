        <footer class="bg-white dark:bg-slate-900 border-t border-sky-100 dark:border-slate-800 py-4 mt-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-2">
                <div>&copy; 2026 <strong>Pon pes Nurul Huda</strong> — Dikelola oleh <strong>Maemun Muzaki</strong></div>
                <div class="flex items-center gap-2">
                    <button onclick="resetDefaultData()" class="text-red-500 hover:underline">Reset Data Awal</button>
                    <span>•</span>
                    <span>Sistem Nilai Bulanan 2 Semester</span>
                </div>
            </div>
        </footer>
    </div>

    <!-- ===================================================================== -->
    <!-- 3. MODALS (Add/Edit Student & Custom Confirmations)                   -->
    <!-- ===================================================================== -->
