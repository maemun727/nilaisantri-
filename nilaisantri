        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(6, 78, 59, 0.6);
        }
        .gold-border {
            border: 1px solid rgba(245, 158, 11, 0.4);
        }
        .gold-glow {
            box-shadow: 0 0 25px rgba(245, 158, 11, 0.25);
        }
        /* Number input arrows removal for cleaner table cells */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }
        input[type=number] {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="font-sans antialiased transition-colors duration-300 bg-iceblue text-slate-800 dark:bg-slate-950 dark:text-slate-100">

    <!-- ===================================================================== -->
    <!-- 1. LOGIN SCREEN (Dark Emerald Green & Gold Theme)                     -->
    <!-- ===================================================================== -->
