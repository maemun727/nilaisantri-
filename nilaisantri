                            </tr>
                        </thead>
                        <tbody id="grades-tbody" class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                            <!-- Rows injected dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

