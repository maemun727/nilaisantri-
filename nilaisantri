                        </div>
                        <div class="text-xl sm:text-2xl font-display font-bold text-slate-800 dark:text-white" id="stat-students">0</div>
                        <div class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-0.5">Terurut Abjad (A-Z)</div>
                    </div>

                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-sky-100 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center justify-between text-slate-400 mb-1">
                            <span class="text-xs font-medium">Rata-rata Kelas</span>
                            <i data-lucide="bar-chart-3" class="w-4 h-4 text-amber-500"></i>
                        </div>
                        <div class="text-xl sm:text-2xl font-display font-bold text-slate-800 dark:text-white" id="stat-avg">0.0</div>
                        <div class="text-[11px] text-slate-500 mt-0.5">Dari 4 Ujian Bulanan</div>
                    </div>

                    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-sky-100 dark:border-slate-800 shadow-sm">
                        <div class="flex items-center justify-between text-slate-400 mb-1">
                            <span class="text-xs font-medium">Nilai Tertinggi</span>
                            <i data-lucide="award" class="w-4 h-4 text-amber-500"></i>
                        </div>
                        <div class="text-xl sm:text-2xl font-display font-bold text-emerald-700 dark:text-amber-400" id="stat-max">0</div>
                        <div class="text-[11px] text-slate-500 truncate mt-0.5" id="stat-top-student">-</div>
                    </div>
                </div>

